# Local LLM (OpenAI-compatible endpoint)
LLM_BASE_URL=http://ollama-cpu:11434
LLM_MODEL=gemma2:2b
EMBEDDING_MODEL=nomic-embed-text
# Embedding backend: ollama (native) | openai_compatible
EMBEDDING_PROVIDER=ollama
# EMBEDDING_BASE_URL=  # 空ならLLM_BASE_URLを流用。openai_compatible時は /v1 付きを指定

# Azure Blob Storage（terraform output -raw storage_connection_string で取得）
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=documents

# Langfuse（初回起動後にLangfuse UIでプロジェクト作成→APIキー生成）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Entra ID (optional - auth skipped if not set, terraform output で取得)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_ALLOWED_GROUP_ID=
AZURE_ADMIN_GROUP_ID=
