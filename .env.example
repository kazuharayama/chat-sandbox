# Azure OpenAI（cmos-maintenance-appのterraform outputから取得）
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_LLM_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Azure Blob Storage（terraform output -raw storage_connection_string で取得）
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=documents

# Langfuse（初回起動後にLangfuse UIでプロジェクト作成→APIキー生成）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Entra ID (optional - auth skipped if not set, terraform output で取得)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_ALLOWED_GROUP_ID=
AZURE_ADMIN_GROUP_ID=
