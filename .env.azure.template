# Azure環境用の環境変数テンプレート
# 実際に使用する際は、このファイルを.env.azure.devまたは.env.azure.prodにコピーして値を設定してください

# Azure Container Registry
AZURE_CONTAINER_REGISTRY=yourregistry
APP_NAME=chat-sandbox
IMAGE_TAG=latest

# Azure認証情報
AZURE_ENTRA_ID_CLIENT_ID=your-client-id
AZURE_ENTRA_ID_TENANT_ID=your-tenant-id

# アプリケーション設定
OPENAI_API_KEY=your-openai-api-key
